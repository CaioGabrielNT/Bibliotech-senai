generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url = env("DATABASE_URL")
}

model Leitor {
    id        Int      @id @default(autoincrement())
    nome      String
    telefone  String   @unique
    email     String   @unique
    matricula String   @unique

    criadoEm  DateTime @default(now())

    @@map("leitor")
}

model Bibliotecario {
    id    Int    @id @default(autoincrement())
    nome  String
    email String @unique
    senha String

    @@map("bibliotecarios")
}

model CategoriaLivro {
    id            Int    @id @default(autoincrement())
    nomeCategoria String
    valorMultaDia Float
    valorCaucao   Float

    livros Livro[]

    @@map("categorias_livros")
}

model Livro {
    id          Int @id @default(autoincrement())
    categoriaId Int
    categoria   CategoriaLivro @relation(fields: [categoriaId], references: [id])

    codigo  String @unique
    titulo  String
    autor   String
    editora String
    genero  String
    ano     Int

    estadoConservacao      String @default("Bom")
    statusDisponibilidade  String @default("Disponivel")

    @@map("livros")
}
