generator client {
    provider = "prisma-client-js"
}

datasource db{
    provider = "sqlite"
    url = env("DATABASE_URL")
}

model Leitor {
    id Int @id @default(autoincrement())
    nome String
    telefone String @unique
    email String @unique
    matricula String @unique

    criadoEm DateTime @default(now())

    @@map("leitor")
}
model CategoriaLivro {
  id            Int   @id @default(autoincrement())
  nomeCategoria String
  valorDiaria   Float
  valorCaucao   Float

  livro livros[]

  @@map("categorias_livros")
}

model Livros {
  id          Int @id @default(autoincrement())
  categoriaId Int

  categoria CategoriaLivros @relation(fields: [categoriaId], references: [id])

  placa  String @unique
  modelo String
  ano    Int

  statusDisponibilidade String @default("Disponivel")

  @@map("livros")
}