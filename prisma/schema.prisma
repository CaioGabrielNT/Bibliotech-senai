generator client {
  provider = "prisma-client-js"
}

datasource db {
  // "postgresql" faz o Prisma gerar SQL no dialeto do Postgres
  // (SERIAL, TIMESTAMP, DOUBLE PRECISION...) em vez do dialeto do SQLite.
  provider = "postgresql"

  // url: usada pela API em produção, no dia a dia. Aponta para o endereço
  // POOLED do Neon (aquele com "-pooler" no host).
  url = env("DATABASE_URL")

  // directUrl: usada APENAS pelos comandos de migration. Aponta para o
  // endereço DIRETO do Neon (sem "-pooler"). Migrations não funcionam
  // através de um connection pooler.
  directUrl = env("DIRECT_URL")
}

model cliente {
  clienteId       Int      @id @default(autoincrement())
  nome            String
  matricula       String   @unique
  email           String   @unique
  senha           String
  telefone        String
  possuiPendencia Boolean  @default(false)

  criadoEm DateTime @default(now())

  emprestimos emprestimo[]

  @@map("cliente")
}

model obra {
  obraId  Int    @id @default(autoincrement())
  isbn    String @unique
  titulo  String
  autor   String
  editora String
  genero  String
  exemplares exemplar[]

  @@map("obra")
}

model exemplar {
  exemplarId          Int    @id @default(autoincrement())
  obraId              Int
  obra                obra   @relation(fields: [obraId], references: [obraId])
  codigoIdentificador String @unique
  estadoDeConservacao String

  statusDisponibilidade String @default("Disponivel")

  emprestimos emprestimo[]

  @@map("exemplar")
}

model emprestimo {
  emprestimoId Int @id @default(autoincrement())

  clienteId  Int
  exemplarId Int

  cliente  cliente  @relation(fields: [clienteId], references: [clienteId])
  exemplar exemplar @relation(fields: [exemplarId], references: [exemplarId])

  dataRetirada          DateTime  @default(now())
  dataPrevistaDevolucao DateTime
  dataDevolucaoReal     DateTime?

  statusContrato String @default("Ativo")

  @@map("emprestimos")
}